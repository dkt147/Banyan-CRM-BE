PORT=5000
NODE_ENV=development

MONGODB_URI=
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Set this to the public HTTPS API origin after deployment (do not include /api/v1).
# Example: https://api.example.com
PUBLIC_API_URL=

# Generate a 32-byte key with: openssl rand -hex 32
# Used to encrypt OAuth access and refresh tokens before they are saved to MongoDB.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Separate signing key for short-lived OAuth state tokens.
INTEGRATION_OAUTH_STATE_SECRET=

# Stripe API credentials. Use test keys for development; use live keys only after approval.
# The CRM Invoices page uses hosted Checkout (secret key + webhook secret).
# Publishable key is retained for the legacy PaymentIntent/Elements endpoint.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local test: run `stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe` and copy its whsec_ value.
# Production: use the signing secret from the registered Stripe Dashboard webhook.
STRIPE_WEBHOOK_SECRET=

# Xero OAuth 2.0 app credentials.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional. Set when the Xero user can authorize more than one organisation.
XERO_TENANT_ID=
# Required for creating Xero sales invoices; use an account code from the client organisation.
XERO_SALES_ACCOUNT_CODE=
# Optional organisation-specific Xero tax type code, e.g. OUTPUT; confirm with the client/accountant.
XERO_DEFAULT_TAX_TYPE=

# One Google OAuth app is shared by Gmail API and Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC

# Meta WhatsApp Business Cloud API credentials.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Default to current Graph API version; change only to a version supported by the client's app.
META_GRAPH_API_VERSION=v26.0
# Optional for webhook events where the sender/contact cannot be matched to a workspace.
WHATSAPP_WORKSPACE_ID=

# DocuSign eSignature JWT credentials. Use demo values for development, production values for go-live.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# The Base URI reported by DocuSign for the account; may include /restapi.
DOCUSIGN_BASE_URI=
# Demo: https://account-d.docusign.com | Production: https://account.docusign.com
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
# Paste PEM key into the environment with newlines preserved or encoded as \n.
DOCUSIGN_RSA_PRIVATE_KEY=
